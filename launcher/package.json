{
  "name": "nexora-launcher",
  "productName": "Nexora-Launcher",
  "version": "1.0.5",
  "description": "Launcher des applis Nexora (comptes et fichiers sur Supabase)",
  "author": "Nexora",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.nexora.launcher",
    "productName": "Nexora-Launcher",
    "artifactName": "Nexora-Launcher-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "Kyxmi",
      "repo": "Nexora-Launcher",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "build/lock-stub.exe",
        "to": "lock-stub.exe"
      }
    ],
    "files": [
      "config.js",
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Nexora-Launcher"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9"
  }
}
